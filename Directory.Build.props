<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Version>0.1.0</Version>
    <Authors>TBankNet.Invoicing contributors</Authors>
    <Product>TBankNet.Invoicing</Product>
    <Copyright>Copyright © TBankNet.Invoicing contributors</Copyright>
    <PackageProjectUrl>https://github.com/ai-iskuzhin/TBankNet.Invoicing</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ai-iskuzhin/TBankNet.Invoicing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>tbank;tinkoff;invoicing;invoice;payments;openapi</PackageTags>
    <PackageReleaseNotes>See https://github.com/ai-iskuzhin/TBankNet.Invoicing/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
</Project>
